# ─── Copia este archivo como .env en la raíz del proyecto ───────────────────
# NUNCA subas .env a GitHub — asegúrate de que esté en .gitignore

# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# Dejar vacío en local para usar SQLite
# En Railway, esta variable se configura automáticamente
DATABASE_URL=

# CORS — URL donde correrá React en local
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary — para imágenes de usuario en producción
# Crear cuenta gratis en cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo — usar App Password de Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
DEFAULT_FROM_EMAIL=tu-correo@gmail.com
